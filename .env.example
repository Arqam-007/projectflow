# ==========================================
# ProjectFlow Environment Variables Template
# ==========================================

# Application Port and Host
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# API Route Prefix
API_PREFIX="/api/v1"

# Database Connection (PostgreSQL - Development)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Matches docker-compose.yml configuration for local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectflow?schema=public"

# Database Connection (PostgreSQL - Dedicated Test Database)
# Used exclusively by integration test suites (npm run test:pg).
# Must NEVER point to the development or production database.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectflow_test?schema=public"

# Strict PostgreSQL Enforcement
# Set to 'true' to disable sandbox in-memory fallback and force immediate failure
# when PostgreSQL is unreachable. Recommended for CI and local development.
STRICT_POSTGRES="false"

# Docker Compose PostgreSQL Settings (Optional overrides for docker-compose.yml)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="projectflow"
POSTGRES_PORT=5432

# JSON Web Token Secret
# Used for signing authentication tokens. In production, provide a strong 32+ character random string.
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"

# Token Expiration (e.g. 15m, 24h, 7d)
JWT_EXPIRES_IN="7d"

# CORS Origin Allowed (Default '*' for development)
CORS_ORIGIN="*"

# Gemini API Key (Optional AI features)
GEMINI_API_KEY="replace-with-your-gemini-api-key"

