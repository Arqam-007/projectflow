# ==========================================
# ProjectFlow Environment Variables Template
# ==========================================

# Application Port and Host
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# API Route Prefix
API_PREFIX="/api/v1"

# Database Connection (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# For local Docker development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectflow?schema=public"

# JSON Web Token Secret
# Used for signing authentication tokens. In production, provide a strong 32+ character random string.
JWT_SECRET="replace-with-a-secure-random-secret-at-least-32-chars"

# Token Expiration (e.g. 15m, 24h, 7d)
JWT_EXPIRES_IN="7d"

# CORS Origin Allowed (Default '*' for development)
CORS_ORIGIN="*"

# Gemini API Key (Optional AI features)
GEMINI_API_KEY="replace-with-your-gemini-api-key"
