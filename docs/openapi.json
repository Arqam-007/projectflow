{
  "openapi": "3.0.3",
  "info": {
    "title": "ProjectFlow REST API",
    "version": "1.0.0",
    "description": "Production-ready REST API specification for ProjectFlow — A multi-tenant project management, task workflow, and executive analytics platform featuring Role-Based Access Control (RBAC), JWT authentication with tokenVersion revocation, atomic concurrency row-locking, and tamper-evident audit logging."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local Development Server"
    },
    {
      "url": "https://api.projectflow.local/api/v1",
      "description": "Production API Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Provide JWT access token obtained via /api/v1/auth/login or /api/v1/auth/register."
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "NOT_FOUND" },
              "message": { "type": "string", "example": "Resource not found" },
              "details": { "type": "object" },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["success", "error"]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "usr_9x8d7f6e" },
          "email": { "type": "string", "format": "email", "example": "alex.owner@projectflow.local" },
          "name": { "type": "string", "example": "Alex Rivera" },
          "avatarUrl": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "email", "name"]
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "ws_1a2b3c4d" },
          "name": { "type": "string", "example": "Acme Engineering" },
          "slug": { "type": "string", "example": "acme-eng" },
          "description": { "type": "string", "nullable": true },
          "ownerId": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "slug", "ownerId"]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "prj_5e6f7g8h" },
          "name": { "type": "string", "example": "Core Platform" },
          "key": { "type": "string", "example": "CORE" },
          "description": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["PLANNING", "ACTIVE", "ON_HOLD", "COMPLETED", "ARCHIVED"] },
          "workspaceId": { "type": "string" },
          "ownerId": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "key", "status", "workspaceId", "ownerId"]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "tsk_0a1b2c3d" },
          "taskNumber": { "type": "integer", "example": 1 },
          "key": { "type": "string", "example": "CORE-1" },
          "title": { "type": "string", "example": "Architect distributed state store" },
          "description": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["BACKLOG", "TODO", "IN_PROGRESS", "IN_REVIEW", "DONE"] },
          "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"] },
          "dueDate": { "type": "string", "format": "date-time", "nullable": true },
          "orderIndex": { "type": "integer", "example": 0 },
          "projectId": { "type": "string" },
          "creatorId": { "type": "string" },
          "assigneeId": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "taskNumber", "title", "status", "priority", "projectId", "creatorId"]
      },
      "ActivityLog": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "workspaceId": { "type": "string", "nullable": true },
          "userId": { "type": "string" },
          "action": { "type": "string", "example": "TASK_CREATED" },
          "entityType": { "type": "string", "example": "TASK" },
          "entityId": { "type": "string" },
          "details": { "type": "object" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "projectId", "userId", "action", "entityType", "entityId"]
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "System Health & Database Connectivity Status",
        "responses": {
          "200": {
            "description": "System operational telemetry and connection status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string", "enum": ["healthy", "degraded", "unhealthy"] },
                        "uptimeSeconds": { "type": "number" },
                        "environment": { "type": "string" },
                        "database": {
                          "type": "object",
                          "properties": {
                            "configured": { "type": "boolean" },
                            "provider": { "type": "string" },
                            "connected": { "type": "boolean" },
                            "latencyMs": { "type": "number" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "minLength": 2, "example": "Alex Rivera" },
                  "email": { "type": "string", "format": "email", "example": "alex@example.com" },
                  "password": { "type": "string", "minLength": 8, "example": "Password123!" }
                },
                "required": ["name", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created and authenticated with JWT" },
          "400": { "description": "Validation error or invalid password requirements" },
          "409": { "description": "Email address already registered" },
          "429": { "description": "Too many registration attempts (rate limit exceeded)" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user credentials",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful; returns user profile and JWT" },
          "401": { "description": "Invalid email or password" },
          "429": { "description": "Too many login attempts (rate limit exceeded)" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Invalidate current user session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Logged out successfully; tokenVersion incremented" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Current user profile" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/workspaces": {
      "get": {
        "summary": "List accessible workspaces",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Array of workspaces where user has membership" }
        }
      },
      "post": {
        "summary": "Create a new workspace",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "minLength": 2 },
                  "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                  "description": { "type": "string" }
                },
                "required": ["name", "slug"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Workspace created; caller assigned as OWNER" },
          "409": { "description": "Workspace slug already in use" }
        }
      }
    },
    "/workspaces/{workspaceId}": {
      "get": {
        "summary": "Get workspace details",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Workspace details" },
          "404": { "description": "Workspace not found or unauthorized (anti-enumeration)" }
        }
      },
      "patch": {
        "summary": "Update workspace details",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Workspace updated" },
          "403": { "description": "Forbidden (requires ADMIN or OWNER)" }
        }
      },
      "delete": {
        "summary": "Delete workspace",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Workspace and all projects deleted (cascaded)" },
          "403": { "description": "Forbidden (requires OWNER)" }
        }
      }
    },
    "/workspaces/{workspaceId}/analytics": {
      "get": {
        "summary": "Get workspace-wide portfolio metrics & project breakdown",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Portfolio analytics data" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/workspaces/{workspaceId}/activities": {
      "get": {
        "summary": "Get workspace audit trail",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "workspaceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Paginated activity logs" }
        }
      }
    },
    "/projects/{projectId}/tasks": {
      "get": {
        "summary": "List tasks with multi-attribute filtering & deterministic sorting",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "status", "in": "query", "description": "Comma-separated statuses", "schema": { "type": "string" } },
          { "name": "priority", "in": "query", "description": "Comma-separated priorities", "schema": { "type": "string" } },
          { "name": "assigneeId", "in": "query", "schema": { "type": "string" } },
          { "name": "overdueOnly", "in": "query", "schema": { "type": "boolean" } },
          { "name": "sortBy", "in": "query", "schema": { "type": "string", "enum": ["orderIndex", "dueDate", "priority", "taskNumber", "title", "status", "createdAt"] } },
          { "name": "sortOrder", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"] } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50 } }
        ],
        "responses": {
          "200": { "description": "Paginated list of tasks matching criteria" },
          "404": { "description": "Project not found or unauthorized" }
        }
      },
      "post": {
        "summary": "Create task with atomic sequential numbering",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string", "minLength": 1, "maxLength": 255 },
                  "description": { "type": "string" },
                  "status": { "type": "string", "enum": ["BACKLOG", "TODO", "IN_PROGRESS", "IN_REVIEW", "DONE"], "default": "TODO" },
                  "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"], "default": "MEDIUM" },
                  "dueDate": { "type": "string", "format": "date-time" },
                  "assigneeId": { "type": "string" }
                },
                "required": ["title"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Task created with assigned project key (e.g. CORE-1)" },
          "400": { "description": "Validation error or invalid assignee membership" }
        }
      }
    },
    "/tasks/{taskId}": {
      "get": {
        "summary": "Get task details",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Task details" },
          "404": { "description": "Task not found" }
        }
      },
      "patch": {
        "summary": "Update task fields",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Task updated" },
          "400": { "description": "Invalid assignee or payload" }
        }
      },
      "delete": {
        "summary": "Delete task with audit logging",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Task deleted" },
          "403": { "description": "Forbidden (only creator, ADMIN, or OWNER can delete)" }
        }
      }
    },
    "/tasks/{taskId}/status": {
      "patch": {
        "summary": "Transition task status via strict state machine",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "enum": ["BACKLOG", "TODO", "IN_PROGRESS", "IN_REVIEW", "DONE"] }
                },
                "required": ["status"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Status transitioned successfully" },
          "400": { "description": "Disallowed status transition (e.g. BACKLOG -> DONE directly)" }
        }
      }
    },
    "/projects/{projectId}/analytics": {
      "get": {
        "summary": "Get real-time project metrics, completion rate, overdue tasks",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Project analytics metrics" },
          "404": { "description": "Project not found" }
        }
      }
    }
  }
}
